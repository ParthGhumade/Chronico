# Google Gemini API Key for Writer, Verifier, and Critic agents
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemma-4-31b-it

# Sarvam AI API Subscription Key for Marathi Speech-to-Text (STT)
SARVAM_API_KEY=your_sarvam_api_key_here
